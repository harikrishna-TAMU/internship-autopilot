\documentclass[letterpaper,11pt]{article}

\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fontawesome5}
\usepackage[T1]{fontenc}
\usepackage{latexsym}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{color}
\usepackage{verbatim}
\usepackage{tabularx}
\usepackage{xcolor}
\ifdefined\pdfgentounicode
  \input{glyphtounicode}
\fi

\addtolength{\oddsidemargin}{-0.6in}
\addtolength{\evensidemargin}{-0.6in}
\addtolength{\textwidth}{1.2in}
\addtolength{\topmargin}{-0.9in}
\addtolength{\textheight}{1.9in}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

\definecolor{primary}{RGB}{20,20,20}
\definecolor{accent}{RGB}{40,90,160}

\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large\color{accent}
}{}{0em}{}[\color{accent}\titlerule \vspace{-5pt}]

\ifdefined\pdfgentounicode
  \pdfgentounicode=1
\fi

\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small\makebox[0pt][l]{#3}} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[3]{
    \item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{\small#1} & {\small #2} \\
      \textit{\small #3} & \\
    \end{tabular*}\vspace{-7pt}
}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.18in, itemsep=0pt, topsep=2pt, parsep=0pt, partopsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

\begin{document}

\begin{center}
    {\Huge \scshape << basics.name|tex >>} \\ \vspace{4pt}
    \small
    << contact >>
\end{center}
\vspace{-4pt}
<% if summary %>

\section{Summary}
\small{
<< summary|texb >>
}
<% endif %>
<% if skills %>

\section{Core Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
<% for g in skills %>
     \textbf{<< g.category|tex >>:} << g.items|join(", ")|tex >><% if not loop.last %> \\ \vspace{2pt}<% endif %>

<% endfor %>
    }}
 \end{itemize}
<% endif %>

\section{Education}
  \resumeSubHeadingListStart
<% for edu, coursework in education %>
    \resumeSubheading
      {<< edu.school|tex >>}{<< (edu.location or "")|tex >>}
      {<< edu.degree|tex >><% if edu.major %>, << edu.major|tex >><% endif %><% if edu.gpa %> \quad | \quad << edu.gpa_label|tex >>: << edu.gpa|string|tex >><% endif %>}{<% if edu.start %><< edu.start|month_year >> -- <% endif %><< edu.grad|month_year >>}
<% if coursework %>
      \resumeItemListStart
        \resumeItem{Coursework: << coursework|join(", ")|tex >>.}
      \resumeItemListEnd
<% endif %>
<% endfor %>
  \resumeSubHeadingListEnd
<% if experience %>

\section{Experience}
  \resumeSubHeadingListStart
<% for exp, bullets in experience %>

    \resumeSubheading
      {<< exp.title|tex >>}{<< exp.dates|tex >>}
      {<< exp.org|tex >>}{<< (exp.location or "")|tex >>}
      \resumeItemListStart
<% for b in bullets %>
        \resumeItem{<< b.text|texb >>}
<% endfor %>
      \resumeItemListEnd
<% endfor %>

  \resumeSubHeadingListEnd
<% endif %>
<% if projects %>

\section{Projects}
    \resumeSubHeadingListStart
<% for proj, bullets in projects %>

      \resumeProjectHeading
          {<< proj.name|tex >><% if proj.subtitle %>{\small{} -- << proj.subtitle|tex >>}<% endif %>}{<< (proj.dates or "")|tex >>}
          {<< proj.tech|join(", ")|tex >><% if proj.advisor %> \quad | \quad Advisor: << proj.advisor|tex >><% endif %>}
          \resumeItemListStart
<% for b in bullets %>
            \resumeItem{<< b.text|texb >>}
<% endfor %>
          \resumeItemListEnd
<% endfor %>

    \resumeSubHeadingListEnd
<% endif %>
<% if leadership %>

\section{<< leadership_title|tex >>}
  \resumeItemListStart
<% for b in leadership %>
        \resumeItem{<< b.text|texb >>}
<% endfor %>
  \resumeItemListEnd
<% endif %>

\end{document}
