# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Only if `autopilot doctor` says your key isn't tied to a workspace (Console → Settings → Workspaces):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Your personal Gmail (the capture inbox). Links go to the same address with +jobs added.
GMAIL_ADDRESS=
# Use your Claude Pro/Max plan through Claude Code instead of API credits: api | claude-code
LLM_BACKEND=api
# CLAUDE_CODE_MODEL=          # optional, e.g. sonnet or opus
# CLAUDE_CODE_CONFIG_DIR=     # optional; empty = Claude Code's default login
